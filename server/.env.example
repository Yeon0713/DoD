# ⚠ 이 파일에는 진짜 키를 넣지 마세요. 이 파일은 GitHub에 올라갑니다.
# 이 파일을 복사해서 .env 로 만든 뒤, 진짜 값은 .env 에만 채우세요. (.env 는 GitHub에 올라가지 않음)
APP_NAME=DoD API
# 프론트(웹) 주소. 여러 개면 ["주소1","주소2"] 형식. 8082 는 mobile/ 앱을 웹으로 켠 주소
CORS_ORIGINS=["http://localhost:3000","http://localhost:8082","http://127.0.0.1:8082"]

# 내 컴퓨터에서 켠 앱(localhost, 127.0.0.1)은 위 목록에 없어도 포트와 상관없이 받는다. 배포 서버에서 끄려면 아래 줄의 # 을 지운다
# CORS_ORIGIN_REGEX=

# 시험용 기능(앱 시작 화면 메뉴의 초기화, 시계 앞당기기 /dev/clock). python run_dev.py 로 켜면 자동으로 true. 배포에서는 켜지 않는다
DEV_CLOCK_ENABLED=false
# 매장을 등록할 때 그 가게용 목업 주문·매출·알바 데이터를 넣을지 (POS·배달앱 연동 전 시연용)
DEMO_STORE_DATA=true

# 로그인이 생기기 전까지 보여 줄 가게 (s001 한림국수, s002 두리맥주, s003 석사돈가스, s004 피플스클럽, s005 초옹장)
DEMO_STORE_ID=s001
# 분석과 계획을 다시 계산하는 간격(분)
SNAPSHOT_REFRESH_MINUTES=10
# 카드 문장을 CLOVA X 로 다듬을지 (true/false). CLOVA_STUDIO_API_KEY 가 비어 있으면 원래 문장을 쓴다
SENTENCE_POLISH_ENABLED=true

# 네이버 클라우드 API (콘솔 > 마이페이지 > 계정 관리 > 인증키 관리)
# SENS 문자 보내기도 이 키를 씀
NCLOUD_ACCESS_KEY=
NCLOUD_SECRET_KEY=

# HyperCLOVA X (CLOVA Studio > API 키)
CLOVA_STUDIO_API_KEY=
CLOVA_STUDIO_BASE_URL=https://clovastudio.stream.ntruss.com
CLOVA_STUDIO_MODEL=HCX-005
# 응답을 기다리는 최대 시간(초)
CLOVA_STUDIO_TIMEOUT=30
# CLOVA 토큰 단가(원, 1,000 토큰당). CLOVA Studio 요금표를 보고 넣기. 0 이면 개발자 대시보드에서 비용이 0원으로 보임
CLOVA_PRICE_INPUT_PER_1K=0
CLOVA_PRICE_OUTPUT_PER_1K=0

# Maps: 지도·주소 검색 (Application Services > Maps > Application 등록 > 인증 정보). 데모 테스트 모드의 지도 그림에 필요
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
NAVER_MAPS_BASE_URL=https://maps.apigw.ntruss.com

# NAVER API HUB: 네이버 검색(지역·블로그 등)·검색어 트렌드. 데모 테스트 모드의 가게 찾기에 필요
# (Application Services > NAVER API HUB > Application 등록 > 인증 정보)
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
NAVER_API_HUB_BASE_URL=https://naverapihub.apigw.ntruss.com

# SENS: 문자 알림 (Application Services > Simple & Easy Notification Service)
# 서비스 ID 예) ncp:sms:kr:123456789012:dod
SENS_SMS_SERVICE_ID=
# 보내는 번호. 콘솔에 등록된 번호만 가능, 숫자만
SENS_SMS_FROM=


# 기상청 API허브 인증키 (apihub.kma.go.kr 회원가입 > 마이페이지 > 인증키). 공공데이터포털(data.go.kr) 키와 다르다
# 아래 API 마다 API허브에서 활용신청이 승인돼야 한다 (server/app/weather/README.md)
# 비워 두면 매장을 등록해도 기상청 날씨를 받지 않고 공통 목업 날씨를 쓴다
KMA_API_KEY=

# 네이버 아이디로 로그인 (developers.naver.com 에 등록한 애플리케이션). 비워 두면 임시 네이버 로그인(테스트 계정 dona_test1 ~ 3)을 쓴다
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
# 네이버 개발자 센터에 적은 Callback URL 과 글자 하나까지 같아야 한다
NAVER_LOGIN_CALLBACK_URL=http://localhost:8000/api/auth/naver/callback

# 개발자 대시보드 (로컬 시험용, 배포에서는 false). true 면 http://localhost:8000/dev-dashboard/ 가 열림
DEV_TOOLS_ENABLED=false
DEV_CLOCK_ENABLED=false

# CLOVA X 토큰 가격
CLOVA_PRICE_INPUT_PER_1K=1.25
CLOVA_PRICE_OUTPUT_PER_1K=5
