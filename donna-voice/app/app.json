{
  "expo": {
    "name": "DONNA",
    "slug": "donna-voice",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "donnavoice",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": true },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#FBF7F2", "image": "./assets/images/splash-icon.png", "imageWidth": 76 }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
