# ⚠ 이 파일에는 진짜 키를 넣지 마세요. 이 파일은 GitHub에 올라갑니다.
# 이 파일을 복사해서 .env 로 만든 뒤, 진짜 값은 .env 에만 채우세요. (.env 는 GitHub에 올라가지 않음)
APP_NAME=DoD API
# 프론트(웹) 주소. 여러 개면 ["주소1","주소2"] 형식. 8082 는 mobile/ 앱을 웹으로 켠 주소
CORS_ORIGINS=["http://localhost:3000","http://localhost:8082","http://127.0.0.1:8082"]

# 로그인이 생기기 전까지 보여 줄 가게 (s001 한림국수, s002 두리맥주, s003 석사돈가스)
DEMO_STORE_ID=s001
# 분석과 계획을 다시 계산하는 간격(분)
SNAPSHOT_REFRESH_MINUTES=10
# 카드 문장을 CLOVA X 로 다듬을지 (true/false). CLOVA_STUDIO_API_KEY 가 비어 있으면 원래 문장을 쓴다
SENTENCE_POLISH_ENABLED=true

# 네이버 클라우드 API (콘솔 > 마이페이지 > 계정 관리 > 인증키 관리)
# SENS 문자 보내기도 이 키를 씀
NCLOUD_ACCESS_KEY=
NCLOUD_SECRET_KEY=

# HyperCLOVA X (CLOVA Studio > API 키)
CLOVA_STUDIO_API_KEY=
CLOVA_STUDIO_BASE_URL=https://clovastudio.stream.ntruss.com
CLOVA_STUDIO_MODEL=HCX-005
# 응답을 기다리는 최대 시간(초)
CLOVA_STUDIO_TIMEOUT=30

# Maps: 지도·주소 검색 (Application Services > Maps > Application 등록 > 인증 정보)
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
NAVER_MAPS_BASE_URL=https://maps.apigw.ntruss.com

# NAVER API HUB: 네이버 검색(지역·블로그 등)·검색어 트렌드
# (Application Services > NAVER API HUB > Application 등록 > 인증 정보)
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
NAVER_API_HUB_BASE_URL=https://naverapihub.apigw.ntruss.com

# SENS: 문자 알림 (Application Services > Simple & Easy Notification Service)
# 서비스 ID 예) ncp:sms:kr:123456789012:dod
SENS_SMS_SERVICE_ID=
# 보내는 번호. 콘솔에 등록된 번호만 가능, 숫자만
SENS_SMS_FROM=

