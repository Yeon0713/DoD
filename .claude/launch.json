{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd mobile && npx expo start --web --clear --port 8082"],
      "port": 8082
    },
    {
      "name": "server",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd server && DEV_TOOLS_ENABLED=true .venv/bin/python run_dev.py"],
      "port": 8000
    },
    {
      "name": "donna-voice-server",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd donna-voice/server && .venv/bin/python run_dev.py"],
      "port": 8100
    },
    {
      "name": "voice-backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd server && .venv/bin/python -m voice.run_voice"],
      "port": 8100
    },
    {
      "name": "donna-voice-app",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd donna-voice/app && npx expo start --web --port 8090"],
      "port": 8090
    }
  ]
}
